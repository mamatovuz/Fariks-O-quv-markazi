TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite storage. On Railway, mount a volume at /data and set DATA_DIR=/data.
# Locally this defaults to ./.data if unset.
DATA_DIR=/data
# Optional: point straight at the db file instead of using DATA_DIR.
# SQLITE_DB_PATH=/data/fariks.db

# TELEGRAM_CHAT_ID can be a channel username like @your_channel
# or a numeric chat ID. Add the bot as an admin in that channel.
